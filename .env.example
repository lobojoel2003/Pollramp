# Copy to .env for docker compose, or export these before `pnpm dev` / `node build`.

# PostgreSQL connection (docker compose builds this from POSTGRES_PASSWORD).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pollramp
POSTGRES_PASSWORD=change-me

# Public URL of the app. Required behind a proxy; http:// origins disable Secure cookies.
ORIGIN=http://localhost:3000

# Office branding and defaults.
POLLRAMP_OFFICE_NAME="Election Office"
# Two-letter state: picks the default checklist overlay (CA, FL, VA have overlays today).
POLLRAMP_DEFAULT_STATE=

# Map. Any MapLibre style URL works; "offline" uses the bundled county basemap only.
POLLRAMP_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
POLLRAMP_MAP_LAT=39.83
POLLRAMP_MAP_LNG=-98.58
POLLRAMP_MAP_ZOOM=3.5

# Optional: create this administrator on first start (when there are no users yet).
POLLRAMP_ADMIN_EMAIL=
POLLRAMP_ADMIN_PASSWORD=

# Advanced
# POLLRAMP_MIGRATE=false          # skip automatic migrations on start-up
# POLLRAMP_SESSION_DAYS=30
# POLLRAMP_SECURE_COOKIES=true    # force Secure cookies (default: on unless ORIGIN is http://)
# POLLRAMP_MAX_PHOTO_BYTES=6291456
# BODY_SIZE_LIMIT=8M              # adapter-node request limit; must exceed the photo limit
# PORT=3000
