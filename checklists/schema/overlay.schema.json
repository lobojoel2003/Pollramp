{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/lobojoel2003/Pollramp/checklists/schema/overlay.schema.json",
	"title": "Pollramp jurisdiction overlay",
	"description": "Patches, adds or removes items of a base checklist for a state or local jurisdiction. Released under CC0-1.0.",
	"type": "object",
	"required": [
		"kind",
		"id",
		"version",
		"title",
		"jurisdiction",
		"description",
		"license",
		"extends",
		"sources"
	],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"kind": { "const": "overlay" },
		"id": { "$ref": "checklist.schema.json#/$defs/slug" },
		"version": { "$ref": "checklist.schema.json#/$defs/semver" },
		"title": { "type": "string", "minLength": 1 },
		"jurisdiction": { "$ref": "checklist.schema.json#/$defs/jurisdiction" },
		"description": { "type": "string", "minLength": 1 },
		"license": { "const": "CC0-1.0" },
		"extends": {
			"type": "object",
			"required": ["id", "version"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "checklist.schema.json#/$defs/slug" },
				"version": {
					"type": "string",
					"description": "Semver range of compatible base versions, e.g. ^1.0.0.",
					"pattern": "^[\\^~]?\\d+\\.\\d+\\.\\d+$"
				}
			}
		},
		"sources": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "checklist.schema.json#/$defs/source" }
		},
		"kit": { "type": "array", "items": { "$ref": "checklist.schema.json#/$defs/kitItem" } },
		"sections": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"add": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["section"],
						"additionalProperties": false,
						"properties": {
							"after": { "$ref": "checklist.schema.json#/$defs/slug" },
							"section": { "$ref": "checklist.schema.json#/$defs/section" }
						}
					}
				},
				"patch": {
					"type": "object",
					"additionalProperties": {
						"type": "object",
						"additionalProperties": false,
						"properties": { "title": { "type": "string" }, "summary": { "type": "string" } }
					}
				}
			}
		},
		"items": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"patch": {
					"type": "object",
					"propertyNames": { "$ref": "checklist.schema.json#/$defs/itemId" },
					"additionalProperties": {
						"allOf": [{ "$ref": "checklist.schema.json#/$defs/itemFields" }],
						"type": "object",
						"unevaluatedProperties": false,
						"properties": {
							"addReferences": { "type": "array", "items": { "type": "string" } }
						}
					}
				},
				"add": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["section", "item"],
						"additionalProperties": false,
						"properties": {
							"section": { "$ref": "checklist.schema.json#/$defs/slug" },
							"after": { "$ref": "checklist.schema.json#/$defs/itemId" },
							"item": { "$ref": "checklist.schema.json#/$defs/item" }
						}
					}
				},
				"remove": {
					"type": "array",
					"items": { "$ref": "checklist.schema.json#/$defs/itemId" }
				}
			}
		}
	}
}
