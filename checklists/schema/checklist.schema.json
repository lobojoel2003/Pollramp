{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/lobojoel2003/Pollramp/checklists/schema/checklist.schema.json",
	"title": "Pollramp base checklist",
	"description": "A versioned, route-ordered polling place accessibility checklist. Released under CC0-1.0.",
	"type": "object",
	"required": [
		"kind",
		"id",
		"version",
		"title",
		"jurisdiction",
		"description",
		"license",
		"sources",
		"kit",
		"sections"
	],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"kind": { "const": "base" },
		"id": { "$ref": "#/$defs/slug" },
		"version": { "$ref": "#/$defs/semver" },
		"title": { "type": "string", "minLength": 1 },
		"jurisdiction": { "$ref": "#/$defs/jurisdiction" },
		"description": { "type": "string", "minLength": 1 },
		"license": { "const": "CC0-1.0" },
		"sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
		"kit": { "type": "array", "items": { "$ref": "#/$defs/kitItem" } },
		"sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
	},
	"$defs": {
		"slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
		"itemId": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
		"semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
		"jurisdiction": {
			"type": "string",
			"description": "ISO 3166-1 alpha-2 country, optionally with an ISO 3166-2 subdivision (US, US-CA).",
			"pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
		},
		"source": {
			"type": "object",
			"required": ["title"],
			"additionalProperties": false,
			"properties": {
				"title": { "type": "string" },
				"publisher": { "type": "string" },
				"url": { "type": "string", "format": "uri" },
				"date": { "type": "string" },
				"note": { "type": "string" }
			}
		},
		"kitItem": {
			"type": "object",
			"required": ["id", "name"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/slug" },
				"name": { "type": "string" },
				"description": { "type": "string" },
				"sizes": { "type": "array", "items": { "type": "string" } }
			}
		},
		"compareOp": { "enum": [">=", "<=", ">", "<", "=="] },
		"passRule": {
			"oneOf": [
				{
					"type": "object",
					"required": ["op", "value"],
					"additionalProperties": false,
					"properties": { "op": { "$ref": "#/$defs/compareOp" }, "value": { "type": "number" } }
				},
				{
					"type": "object",
					"required": ["op", "min", "max"],
					"additionalProperties": false,
					"properties": {
						"op": { "const": "between" },
						"min": { "type": "number" },
						"max": { "type": "number" }
					}
				},
				{
					"type": "object",
					"required": ["op", "fn", "args"],
					"additionalProperties": false,
					"properties": {
						"op": { "enum": [">=", "<="] },
						"fn": { "enum": ["ada208.accessible", "ada208.van"] },
						"args": { "type": "array", "items": { "$ref": "#/$defs/itemId" } }
					}
				},
				{
					"type": "object",
					"required": ["op", "value"],
					"additionalProperties": false,
					"properties": {
						"op": { "const": "equals" },
						"value": { "type": ["boolean", "string"] }
					}
				},
				{
					"type": "object",
					"required": ["op", "values"],
					"additionalProperties": false,
					"properties": {
						"op": { "const": "in" },
						"values": { "type": "array", "minItems": 1, "items": { "type": "string" } }
					}
				}
			]
		},
		"condition": {
			"type": "object",
			"required": ["item", "op"],
			"additionalProperties": false,
			"properties": {
				"item": { "$ref": "#/$defs/itemId" },
				"op": { "enum": [">=", "<=", ">", "<", "==", "equals", "not-equals", "answered"] },
				"value": { "type": ["number", "boolean", "string"] }
			}
		},
		"kitRef": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"item": { "$ref": "#/$defs/slug" },
				"qty": { "type": "integer", "minimum": 1 },
				"per": { "const": "shortfall" },
				"multiplier": { "type": "integer", "minimum": 1 },
				"sizing": { "enum": ["rampForRise"] },
				"from": { "$ref": "#/$defs/itemId" },
				"note": { "type": "string" }
			},
			"anyOf": [{ "required": ["item"] }, { "required": ["sizing"] }]
		},
		"fix": {
			"type": "object",
			"required": ["kind", "summary"],
			"additionalProperties": false,
			"properties": {
				"kind": { "enum": ["kit", "procedure", "structural"] },
				"summary": { "type": "string", "minLength": 1 },
				"steps": { "type": "array", "items": { "type": "string" } },
				"kit": { "type": "array", "items": { "$ref": "#/$defs/kitRef" } },
				"structuralIf": {
					"type": "object",
					"required": ["op", "value", "summary"],
					"additionalProperties": false,
					"properties": {
						"op": { "$ref": "#/$defs/compareOp" },
						"value": { "type": "number" },
						"summary": { "type": "string" }
					}
				}
			}
		},
		"publicText": {
			"type": "object",
			"required": ["label"],
			"additionalProperties": false,
			"properties": {
				"label": { "type": "string" },
				"pass": { "type": "string" },
				"fixed": { "type": "string" },
				"fail": { "type": "string" }
			}
		},
		"itemFields": {
			"type": "object",
			"properties": {
				"type": { "enum": ["measure", "count", "yesno", "choice", "text"] },
				"prompt": { "type": "string", "minLength": 1 },
				"help": { "type": "string" },
				"diagram": { "$ref": "#/$defs/slug" },
				"unit": { "enum": ["in", "ft", "percent", "lbf", "seconds", "count"] },
				"slope": { "type": "boolean" },
				"options": {
					"type": "array",
					"minItems": 2,
					"items": {
						"type": "object",
						"required": ["value", "label"],
						"additionalProperties": false,
						"properties": {
							"value": { "$ref": "#/$defs/slug" },
							"label": { "type": "string" },
							"pass": { "type": "boolean" }
						}
					}
				},
				"pass": { "$ref": "#/$defs/passRule" },
				"when": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
				"fix": { "$ref": "#/$defs/fix" },
				"public": { "$ref": "#/$defs/publicText" },
				"references": { "type": "array", "items": { "type": "string" } }
			}
		},
		"item": {
			"allOf": [{ "$ref": "#/$defs/itemFields" }],
			"type": "object",
			"required": ["id", "type", "prompt"],
			"unevaluatedProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/itemId" }
			}
		},
		"section": {
			"type": "object",
			"required": ["id", "title", "summary", "items"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/slug" },
				"title": { "type": "string" },
				"summary": { "type": "string" },
				"gate": { "$ref": "#/$defs/itemId" },
				"items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
			}
		}
	}
}
